# Copy the needed values into apps/web/.env.local for local development
# and into the Vercel project environment for production.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Required in production for local JWT verification in middleware.
SUPABASE_JWT_SECRET=

# Optional metadata used by /api/health.
NEXT_PUBLIC_APP_VERSION=development

# Optional local analysis flag.
ANALYZE=false
